# --- PostgreSQL (um banco por microserviço) ---
USERS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/users_db"
ORDERS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orders_db"
NOTIFICATIONS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notifications_db"

# --- RabbitMQ (apenas desenvolvimento local) ---
RABBITMQ_URL=amqp://app:app123@localhost:5672

# --- Endereços TCP dos microserviços ---
USERS_SERVICE_HOST=127.0.0.1
USERS_SERVICE_PORT=3001
ORDERS_SERVICE_HOST=127.0.0.1
ORDERS_SERVICE_PORT=3002

# --- API Gateway (HTTP) ---
GATEWAY_PORT=3000

# --- Demonstração da DLQ: pedidos com este total falham no Notifications ---
NOTIFICATIONS_SIMULATE_FAILURE_TOTAL=9999
